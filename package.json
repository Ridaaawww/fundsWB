{
  "name": "funds-radar",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "agent": "node --env-file-if-exists=.env --import tsx agent/cli.ts",
    "update": "node --env-file-if-exists=.env --import tsx agent/cli.ts update",
    "discover": "node --env-file-if-exists=.env --import tsx agent/cli.ts discover",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "x-signals": "node --env-file-if-exists=.env --import tsx agent/cli.ts x-signals"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@mendable/firecrawl-js": "^4.54.0",
    "cheerio": "^1.2.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
